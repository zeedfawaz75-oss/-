# Copy these into your local .env file, then replace the placeholder values
# with the real values from the correct Supabase project.

SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_anon_key"

# Optional server-side security alerts. Configure only in the hosting environment.
# The webhook URL must use HTTPS. When configured, events send after the threshold
# is reached; the secret is sent as an Authorization: Bearer header.
SECURITY_ALERT_WEBHOOK_URL=""
SECURITY_ALERT_WEBHOOK_SECRET=""
# Optional HMAC key for pseudonymizing Cloudflare source IPs; falls back to the
# server-only Supabase service role key when unset.
SECURITY_EVENT_HASH_SECRET=""
WHATSAPP_ALERT_WEBHOOK_URL=""
